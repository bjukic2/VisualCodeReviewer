generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id           String   @id @default(uuid())
  code         String   @db.Text
  summary      String   @db.Text
  architecture Json
  issues       Json
  createdAt    DateTime @default(now())
}